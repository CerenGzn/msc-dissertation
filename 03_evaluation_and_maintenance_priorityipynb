        "            if profile[feature] > 0\n",
        "            else \"below overall mean\"\n",
        "        )\n",
        "\n",
        "        profile_records.append({\n",
        "            \"cell\": cell,\n",
        "            \"feature\": feature,\n",
        "            \"mean_standardized_value\": profile[feature],\n",
